# Hourly, not once a day at the close.
#
# The SOL/USD daily bar closes at 17:00 Pacific and that is the only moment this
# strategy trades all day, so a missed poll is a missed trade and a hole in the
# record. Hourly is self-healing: if one run dies, the next hour picks the bar up.
# A poll with no new closed bar does nothing, so the extra runs are free.
#
# Persistent=true runs a missed poll on boot, which covers the VPS being rebooted
# or suspended across the close.

[Unit]
Description=Run the quantlab poll hourly

# Every 5 minutes, not hourly. This does NOT make the strategy trade more often —
# it decides once per closed daily bar either way, and a poll with no new bar does
# nothing. What it buys is execution. The order is a market order sent whenever the
# poll happens to run, while the backtest assumed a fill at the bar open, so the
# gap between those two is pure delay cost. Measured on the first real fill at
# hourly cadence: 84 bps of drift on top of 31 bps of actual slippage, against a
# strategy with zero headroom at 50 bps round trip. Five minutes caps that drift at
# a twelfth of what an hour allows, for about six minutes of CPU a day.

[Timer]
OnCalendar=*:0/5
Persistent=true
# stagger slightly so every box on the provider is not hitting Alpaca on the tick
RandomizedDelaySec=20
Unit=quantlab-poll.service

[Install]
WantedBy=timers.target
